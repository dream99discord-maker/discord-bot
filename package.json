{
  "name": "the-last-pact-guardian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord e backend di amministrazione per The Last Pact",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && npm run web:build",
    "start": "node dist/src/index.js",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "register-commands": "tsx scripts/register-commands.ts",
    "config:import": "tsx scripts/import-config.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  }
}
